{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin-vikaskumar/:path*", "destination": "/admin" },
    { "source": "/admin/:path*", "destination": "/admin" },
    { "source": "/search/:path*", "destination": "/search" },
    { "source": "/category/:path*", "destination": "/category_shell" },
    { "source": "/:path*", "destination": "/" }
  ]
}
