{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin-vikaskumar/:path*", "destination": "/admin.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/search/:path*", "destination": "/search.html" },
    { "source": "/category/:path*", "destination": "/category_shell.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
